{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"]
    },
    "lint": {},
    "generate": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "type-check": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  },
  "globalPassThroughEnv": [
    "NODE_ENV",
    "VERCEL_URL",
    "NEXTAUTH_SECRET",
    "NEXTAUTH_URL",
    "DISCORD_CLIENT_ID",
    "DISCORD_CLIENT_SECRET",
    "STACK_SECRET_SERVER_KEY",
    "DATABASE_URL",
    "POSTGRES_URL_NON_POOLING",
    "DATABASE_URL_UNPOOLED",
    "POSTGRES_URL_NO_SSL",
    "PGHOST",
    "POSTGRES_HOST",
    "PGHOST_UNPOOLED",
    "PGUSER",
    "POSTGRES_USER",
    "PGDATABASE",
    "POSTGRES_DATABASE",
    "PGPASSWORD",
    "POSTGRES_PASSWORD"
  ]
}
