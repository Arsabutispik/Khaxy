{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"]
    },
    "lint": {},
    "generate": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "type-check": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  },
  "globalPassThroughEnv": [
    "NODE_ENV",
    "VERCEL_URL",
    "NEXTAUTH_SECRET",
    "NEXTAUTH_URL",
    "DISCORD_CLIENT_ID",
    "DISCORD_CLIENT_SECRET",
    "DISCORD_BOT_TOKEN",
    "INTERNAL_API_KEY",
    "FASTIFY_API_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "DATABASE_URL",
    "POSTGRES_URL",
    "POSTGRES_PRISMA_URL",
    "POSTGRES_USER",
    "PGUSER",
    "PGDATABASE",
    "PGPASSWORD",
    "PGHOST",
    "PGHOST_UNPOOLED",
    "POSTGRES_URL_NO_SSL",
    "POSTGRES_PASSWORD",
    "POSTGRES_DATABASE"
  ]
}
