{
  "name": "khaxy-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:bot": "pnpm -F khaxyrewrite run dev:watch",
    "dev:web": "pnpm -F khaxy-dashboard run dev",
    "dev:all": "concurrently \"pnpm dev:bot\" \"pnpm dev:web\"",
    "lint": "turbo run lint",
    "db:generate": "turbo run generate",
    "db:migrate": "pnpm -F @repo/database exec prisma migrate dev",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "type-check": "turbo run type-check",
    "postinstall": "turbo run generate",
    "release": "changeset tag && git push --follow-tags"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "prettier": "^3.7.4",
    "turbo": "latest",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=22.0.0"
  }
}
