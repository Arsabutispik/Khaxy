{
  "name": "khaxy-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "db:generate": "turbo run generate",
    "db:migrate": "pnpm -F @repo/database exec prisma migrate dev",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "type-check": "turbo run type-check"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "latest",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=22.0.0"
  }
}
